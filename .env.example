# 复制为服务器上的 /srv/jukebox/app/.env。不要把填好的 .env 提交到 Git。
JUKEBOX_DOMAIN=jtmakegames.com
JUKEBOX_DATA_DIR=/srv/jukebox/data
JUKEBOX_BACKUP_DIR=/srv/jukebox/backups
# 寿司店 Demo 的发布目录（宿主机路径，挂进 Caddy 容器的 /srv/sushi）。由 deploy/sync-sushi.sh 写入。
SUSHI_RELEASE_DIR=/srv/jukebox/sushi
# 容器内绝对路径。不要改成会随镜像删除的目录。
JUKEBOX_DB_PATH=/data/jukebox.sqlite
